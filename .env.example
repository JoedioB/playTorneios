# Copie para .env (o arquivo .env é ignorado pelo Git). Nunca coloque segredos reais neste exemplo.

# Banco (usado pelo serviço db e pela api)
POSTGRES_USER=playtorneios
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=playtorneios

# API
# Gere com: openssl rand -base64 48
COOKIE_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
# "true" exige HTTPS para o cookie de sessão. Em http://localhost use "false".
COOKIE_SECURE=false
# Permite criar contas pela tela de cadastro. Desligue depois de criar a sua.
ALLOW_SIGNUP=true
SESSION_IDLE_HOURS=8
# Senhas erradas por IP antes de bloquear o endereço (e por quanto tempo conta a janela). Em Wi-Fi compartilhado de evento, aumente.
LOGIN_IP_MAX_FAILURES=30
LOGIN_IP_WINDOW_MIN=60
SESSION_ABSOLUTE_DAYS=7

# Porta publicada pelo serviço web
WEB_PORT=8080

# HTTPS (opcional): docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d --build
# DOMAIN=torneios.exemplo.com.br
# ACME_EMAIL=voce@exemplo.com.br
