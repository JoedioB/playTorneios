# Regras de cache exatas para o PWA (SPECS §17.3). Errar aqui quebra a atualização ou o modo offline.
# DNS re-resolvido (o container "api" pode ser recriado com outro IP). Valores de ambiente (envsubst na partida):
#   Docker Compose (padrão): API_RESOLVER=127.0.0.11, API_RESOLVER_OPTS=ipv6=off
#   Railway (rede privada):   API_RESOLVER=[fd12::10], API_RESOLVER_OPTS=ipv6=on
resolver ${API_RESOLVER} valid=10s ${API_RESOLVER_OPTS};

# Porta 8080: acesso direto (localhost ou proxy do próprio cliente). Nunca confia em X-Forwarded-For vindo de fora.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  include /etc/nginx/conf.d/locations.inc;
}

# Porta 8081: só para o proxy TLS (Caddy) na rede interna; NÃO é publicada. Aqui o IP do visitante vem do
# X-Forwarded-For que o Caddy define (ele sobrescreve o que o visitante enviar), para o limite de taxa da API
# enxergar cada visitante e não o proxy.
server {
  listen 8081;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  set_real_ip_from 0.0.0.0/0;
  real_ip_header X-Forwarded-For;
  include /etc/nginx/conf.d/locations.inc;
}

# Porta 8082: só para o Cloudflare Tunnel (cloudflared) na rede interna; NÃO é publicada. A Cloudflare define
# CF-Connecting-IP com o IP real do visitante (sobrescreve o que ele enviar); só o cloudflared alcança esta porta.
server {
  listen 8082;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  set_real_ip_from 0.0.0.0/0;
  real_ip_header CF-Connecting-IP;
  include /etc/nginx/conf.d/locations.inc;
}

# Porta 8083: PaaS com proxy na frente (Railway). O IP do visitante vem do X-Forwarded-For; com real_ip_recursive o nginx
# descarta da direita os saltos confiáveis (infraestrutura da Railway, 100.0.0.0/8) e fica com o primeiro não confiável,
# de modo que um X-Forwarded-For forjado pelo visitante (à esquerda) não é usado. Se a cadeia vier de outro caminho
# (CDN fora dessa faixa), o IP visto é o do salto e o limite por IP passa a ser compartilhado (o bloqueio por conta continua valendo).
server {
  listen 8083;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  set_real_ip_from 100.0.0.0/8;
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;
  include /etc/nginx/conf.d/locations.inc;
}
